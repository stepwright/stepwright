  "cards": [
    {
      "dot": "emerald",
      "title": "One loop, no recursion",
      "items": [
        "A child that completes at once is picked up in the same loop",
        "A later completion resumes the machine, or posts it to its home executor when it is bound and the completion arrives on another thread"
      ]
    },
    {
      "dot": "violet",
      "title": "No allocation per step or wait",
      "items": [
        "Children, waiters and work items are members",
        "Waits on primitives (delay, event, mutex, channel) deliver through a per-thread hand-off trampoline, so chains of completions keep constant stack depth"
      ]
    },
    {
      "dot": "rose",
      "title": "Structured cancellation",
      "items": [
        "The start token reaches every child",
        "A parked machine is woken with errc::cancelled unless it has its own on_cancel"
      ]
    },
    {
      "dot": "amber",
      "title": "Debugging",
      "items": [
        "Opt-in live task registry (STEPWRIGHT_TRACK_TASKS) lists each machine's state and resume step"
      ]
    }
  ]
