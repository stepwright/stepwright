  "cards": [
    {
      "dot": "emerald",
      "title": "Steps run one at a time",
      "items": [
        "Only the thread that owns the running state executes a step",
        "Waiting states release the thread: no thread is blocked"
      ]
    },
    {
      "dot": "amber",
      "title": "Where waits end",
      "items": [
        "A child completion, a wake() or the home executor resumes the machine",
        "Synchronous completions continue in the same loop, without recursion"
      ]
    },
    {
      "dot": "rose",
      "title": "Endings",
      "items": [
        "Exactly one completion per start, carrying success or an error",
        "A failed child ends the machine with that error when the next step takes no error argument",
        "After either ending the receiver may start the machine again, or destroy it"
      ]
    }
  ]
